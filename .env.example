# Steam
STEAM_API_KEY=

# LLM (OpenAI Compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.2

# Network proxy (highly recommended for Steam/DuckDuckGo)
HTTP_PROXY=
HTTPS_PROXY=

# OneBot V11 Forward WebSocket
# - Docker compose 内：ws://host.docker.internal:3001 (容器直连宿主 NapCat)
# - 本机直连：ws://127.0.0.1:3001
WS_URL=ws://host.docker.internal:3001
OB11_ACCESS_TOKEN=

# Video
# - Default: subtitle-first ingestion; vision is optional and is known to hallucinate on some gateways.
VISION_ENABLED=0

# Heybox (xiaoheihe) style learning
# - Provide HEYBOX_COOKIE to enable scraping. Cookie is only used in request headers and is NOT persisted.
# - Distilled style is stored in SQLite and injected into both passive replies and proactive summaries.
HEYBOX_COOKIE=
HEYBOX_STYLE_ENABLED=1
HEYBOX_FETCH_INTERVAL=86400

# Admin whitelist (comma-separated QQ IDs)
ADMIN_QQ_LIST=

# Proactive push
PROACTIVE_INTERVAL_GROUP=3600
PROACTIVE_INTERVAL_USER=1800
